import "../../examples/models/lab.scene"
scene inst (ns=scene_lab_mjc) first {
    scene: <pickplace_scene>
    obj <pickplace_objects.box1> {
        model first-box as mjcf { sys path = "model.xml" }
    }
    obj <ws_objects.container_1> {
        model first-variable as mjcf { sys path = "model.xml" }
    }
}
scene inst (ns=scene_lab_mjc) second {
    scene: <pickplace_scene>
    obj <pickplace_objects.box1> {
        model second-box as mjcf { sys path = "model.xml" }
    }
    obj <ws_objects.container_1> {
        model second-variable as mjcf { sys path = "model.xml" }
    }
}
