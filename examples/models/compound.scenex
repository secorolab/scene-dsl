import "shapes.scene"

ns demo = "https://example.org/compound/"

distrib (ns=demo) sphere_scale_range {
    uniform { dimension: 3 lower: (0.04, 0.02, 0.02) upper: (0.08, 0.04, 0.04) }
}
distrib (ns=demo) wall_scale_range {
    uniform { dimension: 3 lower: (0.01, 0.2, 0.08) upper: (0.02, 0.3, 0.12) }
}
distrib (ns=demo) block_scale_range {
    uniform { dimension: 1 lower: (0.03) upper: (0.05) }
}
distrib (ns=demo) mesh_scale_range {
    uniform { dimension: 3 lower: (0.5, 0.5, 0.5) upper: (1.5, 1.5, 1.5) }
}

scene inst (ns=demo) compound_demo {
    scene: <demo_scene>
    kgraph (ns=demo) world {
        anchor: <ground.origin>
        body ground { frame origin { } }
        body bin {
            frame center {
                pose bin_in_world {
                    wrt: <ground.origin>
                    xyz: (0.0, 0.0, 0.2) m
                    orientation: euler { angles: (0.0, 0.0, 0.0) }
                }
            }
            frame side {
                pose side_in_bin {
                    wrt: <center>
                    xyz: (0.1, 0.0, 0.0) m
                    orientation: euler { axes: xyz angles: (0.0, 0.0, 1.5707963267948966) }
                }
            }
            frame cone_center {
                pose cone_in_bin {
                    wrt: <center>
                    xyz: (0.3, 0.0, 0.0) m
                    orientation: euler { angles: (0.0, 0.0, 0.0) }
                }
            }
            frame tetra_center {
                pose tetra_in_bin {
                    wrt: <center>
                    xyz: (-0.3, 0.0, 0.0) m
                    orientation: euler { angles: (0.0, 0.0, 0.0) }
                }
            }
            frame triangle_center {
                pose triangle_in_bin {
                    wrt: <center>
                    xyz: (0.0, -0.3, 0.0) m
                    orientation: euler { angles: (0.0, 0.0, 0.0) }
                }
            }
            shape rectangular-prism floor {
                frame: <center>
                scale: (0.2, 0.3, 0.01)
                color: (0.5, 0.5, 0.5, 1.0)
            }
            shape rectangular-prism wall {
                frame: <side>
                scale: sample <wall_scale_range>
            }
            shape sphere marker {
                frame: <side>
                scale: sample <sphere_scale_range>
            }
            shape cylinder post {
                frame: <center>
                scale: (0.02, 0.03, 0.1)
            }
            shape right-circular-cone cone {
                frame: <cone_center>
                scale: (0.08, 0.08, 0.12)
                color: (0.9, 0.5, 0.1, 1.0)
            }
            shape tetrahedron solid {
                frame: <tetra_center>
                scale: 0.09
                color: (0.6, 0.2, 0.9, 1.0)
            }
            shape triangular-prism wedge {
                frame: <triangle_center>
                scale: sample <sphere_scale_range>
                color: (0.2, 0.8, 0.3, 1.0)
            }
            shape mesh tetra {
                frame: <center>
                path: "../assets/tetra.stl"
                scale: sample <mesh_scale_range>
            }
            shape rectangular-prism block {
                frame: <center>
                scale: sample <block_scale_range>
            }
        }
    }
}
