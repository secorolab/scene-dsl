FQN: IRI_TRUNK+['.'];
Import: 'import' importURI=STRING;
Comment: /\/\/.*$/;
NamespaceDeclare: 'ns' name=IRI_TRUNK '=' uri=STRING ;
IRI_TRUNK: /[^\d\W][\w-]*\b/;
// A file named by path: on this system (absolute, or relative to the model naming it), or in a ROS package.
SystemPath: 'sys' 'path' '=' path=STRING ;
RosPath: 'ros' 'pkg' '=' pkg=STRING ',' 'path' '=' path=STRING ;
FileSpec: SystemPath | RosPath ;
PyModuleAttr: 'py' '{' 'module' ':' modules=ID+['.'] ',' 'attr' ':' attr_name=ID '}';
FloatVector: '(' values+=FLOAT[','] ')';
IntVector: '(' values+=INT[','] ')';
