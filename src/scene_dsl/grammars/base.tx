FQN: IRI_TRUNK+['.'];
Import: 'import' importURI=STRING;
Comment: /\/\/.*$/;
NamespaceDeclare: 'ns' name=IRI_TRUNK '=' uri=STRING ;
IRI_TRUNK: /[^\d\W][\w-]*\b/;
// A relative system path is relative to the model naming it.
SystemPath: 'sys' 'path' '=' path=STRING ;
PackagePath: kind=PackageKind 'pkg' '=' pkg=STRING ',' 'path' '=' path=STRING ;
PackageKind: 'ros' | 'py' ;
FileSpec: SystemPath | PackagePath ;
PyModuleAttr: 'py' '{' 'module' ':' modules=ID+['.'] ',' 'attr' ':' attr_name=ID '}';
FloatVector: '(' values+=FLOAT[','] ')';
IntVector: '(' values+=INT[','] ')';
