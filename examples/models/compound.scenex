import "shapes.scene"

ns demo = "https://example.org/compound/"

distrib (ns=demo) sphere_scale_range {
    uniform { dimension: 3 lower: (0.04, 0.02, 0.02) upper: (0.08, 0.04, 0.04) }
}
distrib (ns=demo) wall_scale_range {
    uniform { dimension: 3 lower: (0.01, 0.2, 0.08) upper: (0.02, 0.3, 0.12) }
}
distrib (ns=demo) block_scale_range {
    uniform { dimension: 1 lower: (0.03) upper: (0.05) }
}
distrib (ns=demo) mesh_scale_range {
    uniform { dimension: 3 lower: (0.5, 0.5, 0.5) upper: (1.5, 1.5, 1.5) }
}

scene inst (ns=demo) compound_demo {
    scene: <demo_scene>
    kgraph (ns=demo) world {
        anchor: <ground.origin>
        body ground { frame origin { } }
        body bin {
            frame center {
                pose bin_in_world {
                    wrt: <ground.origin>
                    xyz: (0.0, 0.0, 0.2) m
                    orientation: euler { angles: (0.0, 0.0, 0.0) }
                }
            }
            frame side {
                pose side_in_bin {
                    wrt: <center>
                    xyz: (0.1, 0.0, 0.0) m
                    orientation: euler { axes: xyz angles: (0.0, 0.0, 1.5707963267948966) }
                }
            }
            shape UnitCube floor {
                frame: <center>
                scale: (0.2, 0.3, 0.01)
                color: (0.5, 0.5, 0.5, 1.0)
            }
            shape UnitCube wall {
                frame: <side>
                scale: sample <wall_scale_range>
            }
            shape UnitSphere marker {
                frame: <side>
                scale: sample <sphere_scale_range>
            }
            shape UnitCylinder post {
                frame: <center>
                scale: (0.02, 0.03, 0.1)
            }
            shape UnitCube solid {
                frame: <side>
                scale: 0.09
                color: (0.6, 0.2, 0.9, 1.0)
            }
            shape file tetra {
                frame: <center>
                path: "../assets/tetra.stl"
                scale: sample <mesh_scale_range>
            }
            shape UnitCube block {
                frame: <center>
                scale: sample <block_scale_range>
            }
        }
    }
}
