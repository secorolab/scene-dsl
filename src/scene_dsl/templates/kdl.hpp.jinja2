{%- macro identifier(name) -%}
{{ name | replace('/', '_') | replace('-', '_') }}
{%- endmacro -%}

{%- macro vector(values) -%}
KDL::Vector({{ values[0] }}, {{ values[1] }}, {{ values[2] }})
{%- endmacro -%}

{%- macro joint(joint) -%}
{%- if joint.kind == 'fixed' -%}
KDL::Joint({% if joint.name %}"{{ joint.name }}", {% endif %}KDL::Joint::None)
{%- elif joint.kind == 'revolute' -%}
KDL::Joint("{{ joint.name }}", {{ vector(joint.origin) }}, {{ vector(joint.axis) }}, KDL::Joint::RotAxis)
{%- else -%}
#error "no KDL joint for a {{ joint.kind }} joint"
{%- endif -%}
{%- endmacro -%}

{%- macro inertia(inertia) -%}
{%- if inertia is none -%}
KDL::RigidBodyInertia::Zero()
{%- else -%}
KDL::RigidBodyInertia({{ inertia.mass }}, {{ vector(inertia.cog) }},
            KDL::RotationalInertia({{ inertia.moments[0] }}, {{ inertia.moments[1] }}, {{ inertia.moments[2] }}, {{ inertia.moments[3] }}, {{ inertia.moments[4] }}, {{ inertia.moments[5] }}))
{%- endif -%}
{%- endmacro -%}

{%- macro segment(segment) -%}
KDL::Segment("{{ segment.name }}",
            {{ joint(segment.joint) }},
            KDL::Frame(KDL::Rotation::Quaternion({{ segment.quat[0] }}, {{ segment.quat[1] }}, {{ segment.quat[2] }}, {{ segment.quat[3] }}), {{ vector(segment.pos) }}),
            {{ inertia(segment.inertia) }})
{%- endmacro -%}
// This is an auto-generated file. Do not edit it directly.
//
// KDL trees and chains for the kinematics of: {{ data.source }}
#pragma once

#include <kdl/chain.hpp>
#include <kdl/frames.hpp>
#include <kdl/tree.hpp>
#include <stdexcept>

namespace {{ identifier(data.name) }} {
{% for tree in data.trees %}
inline KDL::Tree make_tree_{{ identifier(tree.name) }}()
{
    KDL::Tree tree("{{ tree.root }}");
{%- for seg in tree.segments %}
    if (!tree.addSegment(
          {{ segment(seg) }},
          "{{ seg.hook }}")) {
        throw std::runtime_error("{{ data.name }}: cannot hang '{{ seg.name }}' from '{{ seg.hook }}'");
    }
{%- endfor %}
    return tree;
}
{% for chain in tree.chains %}
inline KDL::Chain make_chain_{{ identifier(chain.name) }}()
{
    KDL::Chain chain;
    if (!make_tree_{{ identifier(tree.name) }}().getChain("{{ chain.root }}", "{{ chain.tip }}", chain)) {
        throw std::runtime_error("{{ data.name }}: no chain from '{{ chain.root }}' to '{{ chain.tip }}'");
    }
    return chain;
}
{% endfor %}
{%- endfor %}
}  // namespace {{ identifier(data.name) }}
