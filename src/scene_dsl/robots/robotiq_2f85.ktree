// Robotiq 2F-85 gripper template.
//
// The 2F-85 is attached with the "g_" prefix in the assembled MJCF, so its elements
// carry it here. Transforms and inertias are generated from 2f85.xml.
ktree gripper_tree {
    root: <g_base_mount.g_base_mount_origin>
    // Partial: only the mount, the palm carrying the TCP, and the actuated driver.
    // The 4-bar linkage (couplers, followers, pads) and the `split` tendon stay in
    // the MJCF -- scenex has no closed-loop or tendon construct.
    body g_base_mount {
        frame g_base_mount_origin { }
        // Mating surface: base_mount sits 7mm along +z of the frame it bolts to.
        frame g_mount_interface {
            pose g_mount_interface_in_g_base_mount {
                wrt: <g_base_mount.g_base_mount_origin>
                xyz: (0, 0, -0.007) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        // 2f85.xml states no <inertial> for base_mount: MuJoCo derives it from the mesh
        // geoms at compile time, so the compiled values are carried here instead.
        frame g_base_mount_com {
            pose g_base_mount_com_in_g_base_mount {
                wrt: <g_base_mount.g_base_mount_origin>
                xyz: (-0.0003605835958214157, 8.536274800937428e-05, -5.9199141450506514e-05) m
                orientation: quat {
                    xyzw: (0.7060997694368735, 0.0005237112247473686,
                           0.708111974627504, -0.0005222230216346258)
                }
            }
        }
        inertia {
            frame: <g_base_mount_com>
            mass: 0.15000285516377976 kg
            inertia-matrix: (
                (0.00010234548901794908, 0.0, 0.0),
                (0.0, 5.35996872189825e-05, 0.0),
                (0.0, 0.0, 5.217176310506675e-05)
            ) kg*m^2
        }
    }
    body g_base {
        frame g_base_origin {
            pose g_base_in_g_base_mount {
                wrt: <g_base_mount.g_base_mount_origin>
                xyz: (0, 0, 0.0038) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, -90) unit: deg }
            }
        }
        frame g_pinch {
            pose g_pinch_in_g_base {
                wrt: <g_base.g_base_origin>
                xyz: (0, 0, 0.145) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        frame g_left_driver_joint_anchor {
            pose g_left_driver_joint_anchor_in_g_base {
                wrt: <g_base.g_base_origin>
                xyz: (0, -0.0306011, 0.054904) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 180) unit: deg }
            }
        }
        frame g_base_com {
            pose g_base_com_in_g_base {
                wrt: <g_base.g_base_origin>
                xyz: (0, -2.70394e-05, 0.0354675) m
                orientation: euler { axes: xyz extrinsic angles: (-0.175152, 0, 0) unit: deg }
            }
        }
        // The palm carries the whole gripper: the 4-bar linkage, pads and springs below are
        // not described here, so their mass is lumped in with it, as MuJoCo lumps the tool
        // subtree today. Composite of all 13 bodies at or under 2f85.xml's 'base', with the
        // fingers at their rest configuration, expressed in this body's frame.
        frame g_base_lumped_com {
            pose g_base_lumped_com_in_g_base {
                wrt: <g_base.g_base_origin>
                xyz: (0.0, -2.3289840972067775e-05, 0.04247701482094086) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        inertia {
            frame: <g_base_lumped_com>
            mass: 0.9026054836789594 kg
            inertia-matrix: (
                (0.0009287010595313735, 1.202439660816404e-11, -3.605993341917436e-16),
                (1.202439660816404e-11, 0.0005835572393484526, -3.695091338611354e-07),
                (-3.605993341917436e-16, -3.695091338611354e-07, 0.0004776404071743112)
            ) kg*m^2
        }
    }
    body g_left_driver {
        frame g_left_driver_origin { }
        frame g_left_driver_com {
            pose g_left_driver_com_in_g_left_driver {
                wrt: <g_left_driver.g_left_driver_origin>
                xyz: (0, 0.0177547, 0.00107314) m
                orientation: euler { axes: xyz extrinsic angles: (94.1092, 0, 0) unit: deg }
            }
        }
        inertia {
            frame: <g_left_driver_com>
            mass: 0.00899563 kg
            inertia-matrix: (
                (1.72352e-06, 0.0, 0.0),
                (0.0, 1.60906e-06, 0.0),
                (0.0, 0.0, 3.22006e-07)
            ) kg*m^2
        }
    }
    joints {
        fixed g_base_on_mount {
            parent: <g_base_mount.g_base_mount_origin>
            child: <g_base.g_base_origin>
        }
        // Driven by the g_fingers_actuator tendon; the right finger mirrors it.
        revolute g_left_driver_joint {
            parent: <g_base.g_left_driver_joint_anchor>.x
            child: <g_left_driver.g_left_driver_origin>.x
            actuation {
                gear ratio: 1.0
                command-interface: position
                state-interface: position
            }
            limits {
                position: (0, 0.8) rad
                effort: (-5, 5) N*m
            }
            polarity: PositivePolarity
        }
    }
}
