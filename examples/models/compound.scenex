import "shapes.scene"

ns demo = "https://example.org/compound/"

scene inst (ns=demo) compound_demo {
    scene: <demo_scene>
    kgraph (ns=demo) world {
        anchor: <ground.origin>
        body ground { frame origin { } }
        body bin {
            frame center {
                pose bin_in_world {
                    wrt: <ground.origin>
                    xyz: (0.0, 0.0, 0.2) m
                    orientation: euler { angles: (0.0, 0.0, 0.0) }
                }
            }
            frame side {
                pose side_in_bin {
                    wrt: <center>
                    xyz: (0.1, 0.0, 0.0) m
                    orientation: euler { axes: xyz angles: (0.0, 0.0, 1.5707963267948966) }
                }
            }
            shape UnitCube floor {
                frame: <center>
                unit: m
                scale: (0.2, 0.3, 0.01)
                color: (0.5, 0.5, 0.5, 1.0)
            }
            shape UnitCube wall {
                frame: <side>
                unit: cm
                scale: (1.5, 25, 10)
            }
            shape UnitSphere marker {
                frame: <side>
                unit: mm
                scale: (60, 30, 30)
            }
            shape UnitCylinder post {
                frame: <center>
                unit: m
                scale: (0.02, 0.03, 0.1)
            }
            shape UnitCube solid {
                frame: <side>
                unit: m
                scale: 0.09
                color: (0.6, 0.2, 0.9, 1.0)
            }
            shape file tetra {
                frame: <center>
                path: "../assets/tetra.stl"
                unit: m
                scale: (1.2, 1.0, 0.8)
            }
            shape UnitCube block {
                frame: <center>
                unit: m
                scale: 0.04
            }
        }
        frame free_marker_frame {
            pose free_marker_in_world {
                wrt: <ground.origin>
                xyz: (-0.3, 0.0, 0.1) m
                orientation: euler { angles: (0.0, 0.0, 0.0) }
            }
        }
        shape UnitSphere free_marker {
            frame: <free_marker_frame>
            unit: m
            scale: 0.04
        }
    }
}
